# Copy to .env and fill in — .env is gitignored (public repo, keep IPs out of git)
HA_HOST=
HA_CC_PATH=/usr/share/hassio/homeassistant/custom_components
# HA REST API (tools/check_regs.py): base URL + admin account (username/password,
# exchanged for a short-lived token via the HA login flow — NOT a token itself)
HASS_URL=
HA_ADMIN_USER=
HA_ADMIN_PASSWORD=
# …or a long-lived access token instead of user/password: HASS_TOKEN=
# Direct Modbus (check_regs.py --direct, tools/modbus_probe.py): bridge/host, port, unit id
# (Modbus TCP bridges often listen on 8899 instead of 502)
MODBUS_HOST=
MODBUS_PORT=502
MODBUS_SLAVE=1
