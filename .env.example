# Copy to .env and fill in — .env is gitignored (public repo, keep IPs out of git)
HA_HOST=
HA_CC_PATH=/usr/share/hassio/homeassistant/custom_components
# Direct Modbus (check_regs.py --direct, tools/modbus_probe.py): bridge/host, port, unit id
# (Modbus TCP bridges often listen on 8899 instead of 502)
MODBUS_HOST=
MODBUS_PORT=502
MODBUS_SLAVE=1
