#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"
PY="${FOXAIR_PY:-python3}"
"$PY" tools/validate.py || {
    echo "pre-push: tools/validate.py failed — push blocked" >&2
    exit 1
}
if "$PY" -c "import pytest" 2>/dev/null; then
    "$PY" -m pytest tests/ -q || {
        echo "pre-push: pytest failed — push blocked" >&2
        exit 1
    }
else
    echo "pre-push: pytest not available in $PY — set FOXAIR_PY to a 3.11+ venv (see AGENTS.md)" >&2
    exit 1
fi
