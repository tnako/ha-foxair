{
  "version": "1.0.0",
  "_comment": "Single source of truth for integration-wide configuration (functional data only — no translations; see translations/*.json for i18n). Consumed by tools/build_metadata.py (generation) and by the runtime (coordinator/climate) loaded once via _load_config(). Do NOT put credentials/IP here.",
  "poll_intervals": {
    "_comment": "Multiples of base_seconds (30s). quick=30s, medium=120s, rare=300s/600s-expert.",
    "base_seconds": 30,
    "quick": 1,
    "medium": 4,
    "rare": 10
  },
  "modbus": {
    "_comment": "max_span 90: the unit answers a read of more than 90 registers with only the first 90 and no error, so words past +90 were never read (1106-1112, 1287-1296 in the 0.7.13 diagnostics).",
    "max_span": 90,
    "max_gap": 30,
    "default_port": 502
  },
  "dead_ranges": [
    [
      200,
      215
    ],
    [
      2029,
      2031
    ]
  ],
  "_dead_ranges_comment": "Address ranges excluded from contiguous read batches. 200-215 = PHNIX/Aliyun ProductKey ASCII (FC10, no FC03 answer, EW11 corruption). 2029-2031 = T-Diag5-7 FC16 words that broke batch responses (v0.4.24); 2032 is read alone via isolated_addrs.",
  "isolated_addrs": [2032],
  "_isolated_addrs_comment": "Addrs read with their own single-register request, never inside a batch. 2032 compressor runtime (h): FoxAir_Control reads it inside its 2001+90 live block, but here 2029-2032 inside a batch broke the whole EW11 response (v0.4.24), so it is read alone and batches never span it. A failed single read only loses that addr. 2029-2031 (input current L1-L3, untested) stay blocked and dead.",
  "hidden_comment": "Address ranges permanently hidden from the UI (not even in expert mode) and excluded from polling/editing: protocol block headers, reserved/factory test, cloud/wifi/serial identifiers, system clock, board/service info. 'keep' addresses inside these ranges stay visible (used by climate/curve/main device). Note: 1015 (language selection, unknown value map), 1017 (logo selection, unknown value map), 1025-1026 (H38/H39 display-firmware language/logo codes, value map unknown), 1078-1079 (ASM Zone2 compensation params) and 1348-1352 (C13-E21 display-firmware parameters not visible in app) are excluded. 1016 (Silent Status bitfield) is excluded from hidden ranges — it is firmware-gated (>=3.3) via min_firmware in foxair_config.json overrides, since the manual defrost/silent/manual-heat bits only exist on Firmware 3.3+.",
