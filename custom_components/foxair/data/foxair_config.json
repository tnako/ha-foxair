{
  "version": "1.0.0",
  "_comment": "Single source of truth for integration-wide configuration (functional data only — no translations; see translations/*.json for i18n). Consumed by tools/build_metadata.py (generation) and by the runtime (coordinator/climate) loaded once via _load_config(). Do NOT put credentials/IP here.",

  "poll_intervals": {
    "_comment": "Multiples of base_seconds (30s). quick=30s, medium=120s, rare=300s/600s-expert.",
    "base_seconds": 30,
    "quick": 1,
    "medium": 4,
    "rare": 10
  },

  "modbus": {
    "max_span": 45,
    "max_gap": 8,
    "default_port": 502
  },

  "dead_ranges": [
    [200, 215],
    [2029, 2032]
  ],
  "_dead_ranges_comment": "Address ranges excluded from contiguous read batches. 200-215 = PHNIX/Aliyun ProductKey ASCII (FC10, no FC03 answer, EW11 corruption). 2029-2032 = T-Diag5-8 write-only FC16 registers that return no data.",

